# Cloudflare bot bypass when scanning Dynamic Business live/beta hosts.
# Copy values into ~/.config/db-eng/cf-bots.env (chmod 600) — do NOT commit secrets.
# Source before runs:  set -a && source ~/.config/db-eng/cf-bots.env && set +a
#
# Or pass explicitly:
#   --header "x-smoke-key: $CF_SMOKE_KEY"
#   --header "CF-Access-Client-Id: $CF_ACCESS_CLIENT_ID"
#   --header "CF-Access-Client-Secret: $CF_ACCESS_CLIENT_SECRET"

CF_SMOKE_KEY=
# Alias also accepted: X_SMOKE_KEY=

CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
