# Copy into ~/.config/db-eng/cf-bot.env (chmod 600) — never commit real secrets.
# Host gates (src/cf-bypass-headers.ts):
#   x-smoke-key → dynamicbusiness.com / *.dynamicbusiness.com only
#   CF-Access-* → exact beta.dynamicbusiness.com only
# Manual curl example (beta):
#   --header "x-smoke-key: $CF_SMOKE_KEY"
#   --header "CF-Access-Client-Id: $CF_ACCESS_CLIENT_ID"
#   --header "CF-Access-Client-Secret: $CF_ACCESS_CLIENT_SECRET"
CF_SMOKE_KEY=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
