{
  "name": "@newsengine/saas-security-kit",
  "version": "0.1.0",
  "description": "Reusable security checks for SaaS apps: a black-box URL probe (headers/TLS/security.txt/cookies/CORS) + white-box multi-tenant/IDOR test helpers + checklist & CI templates. Drop into any repo.",
  "type": "module",
  "bin": {
    "security-kit": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "templates"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "probe": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=20" },
  "keywords": ["security", "saas", "owasp", "headers", "csp", "idor", "multi-tenant", "ci"],
  "license": "MIT",
  "devDependencies": { "typescript": "^5.5.0", "@types/node": "^20.0.0" }
}
