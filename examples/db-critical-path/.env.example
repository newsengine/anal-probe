# Copy to a chmod-600 file outside git (e.g. ~/.config/db-eng/vta-db-critical.env) and `source` it.
# NEVER commit real secrets. Missing vars → checks SKIP (pass), they do not false-fail.

# Target (also the CLI arg)
# VTA_BASE_URL=https://dynamicbusiness.com

# Staff roles (Supabase password grant)
VTA_EDITOR_EMAIL=
VTA_EDITOR_PASSWORD=
VTA_SUPERADMIN_EMAIL=
VTA_SUPERADMIN_PASSWORD=

# Non-staff (profiles RLS #1416)
VTA_USER_EMAIL=
VTA_USER_PASSWORD=

# Optional MFA
VTA_TOTP_SECRET=

# Optional Supabase overrides (defaults to Dynamic Business public anon)
# VTA_SUPABASE_URL=https://db.dynamicbusiness.com
# VTA_SUPABASE_ANON_KEY=

# Editorial golden-path fixture (SKIP if unset)
# VTA_UNPUBLISHED_ARTICLE_URL=https://dynamicbusiness.com/dashboard/editor/posts?id=...

# Opt-in Stripe dual-path probe (non-destructive; default SKIP)
# VTA_STRIPE_AMOUNT_PROBE=1

# Cloudflare bot bypass (already supported by anal-probe)
# CF_SMOKE_KEY=
# CF_ACCESS_CLIENT_ID=          # beta.dynamicbusiness.com only
# CF_ACCESS_CLIENT_SECRET=
